# Q0 — Bounded BOTSv3 orientation.
# Inventory period includes the 2018 incident and reported 2019 tail.
# Keep this unfiltered to locate exact collector sourcetype/host pairs.
index=botsv3 earliest=1534723200 latest=1577836800
| stats count by sourcetype host
| sort 0 -count

# Q0b — Identify reported Unix add-on contamination by exact source type.
index=botsv3 earliest=1534723200 latest=1577836800
  sourcetype IN ("ps","top","lsof","netstat","PerfmonMk:Process")
| stats count min(_time) as first_epoch max(_time) as last_epoch
    by host sourcetype source
| sort 0 host sourcetype source

# Q0c — Incident-day time range and host coverage.
index=botsv3 earliest=1534723200 latest=1534809600
  \`botsv3_exclude_unix_ta_noise\`
| stats earliest(_time) as first_epoch latest(_time) as last_epoch
    count dc(sourcetype) as source_types by host
| sort 0 host

# Q0d — Incident-day source-type volume.
index=botsv3 earliest=1534723200 latest=1534809600
  \`botsv3_exclude_unix_ta_noise\`
| timechart span=1h count by sourcetype limit=10

# Q0e — Verify UTC against raw XML rather than adjusting display values.
# Full comparison query is in queries/search-hygiene.spl.
