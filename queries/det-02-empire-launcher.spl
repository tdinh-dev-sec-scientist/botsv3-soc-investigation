# DET-02: Analyst-only encoded PowerShell triage, not a scheduled detector.
# Bound the lab replay and extract the encoded token before decoding.
# Framework label is Empire-like behavior; exact family/version is unverified.

index=botsv3 sourcetype=XmlWinEventLog EventCode=1
  earliest=1534723200 latest=1534809600 host=FYODOR-L
  \`botsv3_exclude_unix_ta_noise\`
| fields _time host User ParentImage Image CommandLine ProcessGuid
| where match(Image,"(?i)\\\\(powershell(?:_ise)?|pwsh)\\.exe$")
    AND match(CommandLine,"(?i)(?:^|\\s)-(?:enc|encodedcommand)(?:\\s|:)")
| rex field=CommandLine "(?i)(?:-enc(?:odedcommand)?)[\\s:]+(?<encoded_command>[A-Za-z0-9+/=]+)"
| where isnotnull(encoded_command)
| eval decoded=base64decode(encoded_command)
| fields _time host User ParentImage Image ProcessGuid encoded_command decoded
| sort 0 _time
