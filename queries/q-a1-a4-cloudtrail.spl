# Direction A — Cloud / AWS. Bounded to the BOTSv3 incident day.

# A1 — API activity overview.
index=botsv3 sourcetype=aws:cloudtrail earliest=1534723200 latest=1534809600
  \`botsv3_exclude_unix_ta_noise\`
| stats count by userIdentity.userName eventName
| sort 0 -count

# A2 — Sensitive API actions with minimal projected fields.
index=botsv3 sourcetype=aws:cloudtrail earliest=1534723200 latest=1534809600
  eventName IN (PutBucketAcl,PutBucketPolicy,CreateUser,CreateAccessKey,
                AttachUserPolicy,StopLogging,DeleteTrail,ConsoleLogin)
  \`botsv3_exclude_unix_ta_noise\`
| fields _time eventID userIdentity.userName sourceIPAddress eventName
    requestParameters.bucketName errorCode
| sort 0 _time

# A3 — CloudTrail records with MFA reported false.
index=botsv3 sourcetype=aws:cloudtrail earliest=1534723200 latest=1534809600
  userIdentity.sessionContext.attributes.mfaAuthenticated=false
  \`botsv3_exclude_unix_ta_noise\`
| stats count values(eventName) as apis by userIdentity.userName

# A4 — Source IPs and API names.
index=botsv3 sourcetype=aws:cloudtrail earliest=1534723200 latest=1534809600
  \`botsv3_exclude_unix_ta_noise\`
| stats count values(eventName) as apis by sourceIPAddress
| sort 0 -count

# Inspect exact ACL/policy fields before claiming public exposure.
index=botsv3 sourcetype=aws:cloudtrail earliest=1534723200 latest=1534809600
  eventName IN (PutBucketAcl,PutBucketPolicy)
  \`botsv3_exclude_unix_ta_noise\`
| fields _time eventID userIdentity.arn sourceIPAddress eventName
    requestParameters errorCode
| sort 0 _time

# Bounded cross-source IOC pivots establish co-occurrence only.
index=botsv3 earliest=1534723200 latest=1534809600 "107.77.212.175"
  \`botsv3_exclude_unix_ta_noise\`
| stats count by sourcetype host
| sort 0 -count

index=botsv3 sourcetype=cisco:asa earliest=1534723200 latest=1534809600
  "107.77.212.175"
| fields _time host _raw
| sort 0 _time

index=botsv3 sourcetype=ms:o365:management earliest=1534723200 latest=1534809600
  "107.77.212.175"
| fields _time user src_ip action _raw
| sort 0 _time
