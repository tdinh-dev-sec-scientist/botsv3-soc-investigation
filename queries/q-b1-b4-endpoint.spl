# Direction B — Windows Endpoint. Bounded before field matching,
# aggregation, and sorting.

# B1 — Rare process names in the incident window.
index=botsv3 sourcetype=XmlWinEventLog EventCode=1
  earliest=1534723200 latest=1534809600
  \`botsv3_exclude_unix_ta_noise\`
| fields host Image
| rare limit=30 Image

# B2 — Encoded/download/decode behavior; no generic CommandLine=*http*.
index=botsv3 sourcetype=XmlWinEventLog EventCode=1
  earliest=1534723200 latest=1534809600
  \`botsv3_exclude_unix_ta_noise\`
| fields _time host User ParentImage Image CommandLine ProcessGuid
| where match(Image,"(?i)\\\\(powershell(?:_ise)?|pwsh|cmd)\\.exe$")
    OR match(CommandLine,
      "(?i)(?:^|\\s)-(?:enc|encodedcommand)(?:\\s|:)|downloadstring|frombase64string|(?:^|[;&|]\\s*)iex(?:\\s|\\(|$)")
| sort 0 _time

# B3 — Account, group, service, and log-clear events.
index=botsv3 sourcetype=WinEventLog EventCode IN (4720,4732,7045,1102)
  earliest=1534723200 latest=1534809600
  \`botsv3_exclude_unix_ta_noise\`
| fields _time host EventCode SubjectUserName TargetUserName TargetSid
    MemberName MemberSid GroupName GroupSid ServiceName Account_Name
| sort 0 _time

# B4 — Sysmon network connections, grouped for triage.
index=botsv3 sourcetype=XmlWinEventLog EventCode=3
  earliest=1534723200 latest=1534809600
  \`botsv3_exclude_unix_ta_noise\`
| stats count min(_time) as first_time max(_time) as last_time
    by host User ProcessGuid Image DestinationIp DestinationPort
| sort 0 -count

# Bounded process lineage and backdoor-account searches.
index=botsv3 host=FYODOR-L sourcetype=XmlWinEventLog EventCode=1
  earliest=1534723200 latest=1534809600
  \`botsv3_exclude_unix_ta_noise\`
| fields _time ParentImage Image CommandLine User ProcessGuid
| where match(Image,"(?i)\\\\powershell(?:_ise)?\\.exe$")
| sort 0 _time

index=botsv3 host=FYODOR-L sourcetype=XmlWinEventLog EventCode=1
  earliest=1534723200 latest=1534809600 CommandLine="*svcvnc*"
  \`botsv3_exclude_unix_ta_noise\`
| fields _time ParentImage Image CommandLine User ProcessGuid
| sort 0 _time

# A shared destination is an IOC pivot, not proof of movement.
index=botsv3 earliest=1534723200 latest=1534809600 "45.77.53.176"
  \`botsv3_exclude_unix_ta_noise\`
| stats count by sourcetype host
| sort 0 -count

# Raw fodhelper event for registry/token follow-up.
index=botsv3 host=FYODOR-L sourcetype=XmlWinEventLog EventCode=1
  earliest=1534723200 latest=1534809600 CommandLine="*fodhelper*"
  \`botsv3_exclude_unix_ta_noise\`
| fields _time host _raw
| sort 0 _time
