# DET-03: fodhelper.exe launch from PowerShell; UAC bypass is a hypothesis.
# This bounded hunt does not confirm registry hijack or elevated token state.

index=botsv3 sourcetype=XmlWinEventLog EventCode=1
  earliest=1534723200 latest=1534809600
  \`botsv3_exclude_unix_ta_noise\`
| fields _time host User ParentImage Image CommandLine ProcessGuid
| where match(Image,"(?i)\\\\fodhelper\\.exe$")
    AND match(ParentImage,"(?i)\\\\powershell(?:_ise)?\\.exe$")
| sort 0 _time
