# DET-05: High-volume PowerShell network activity (not periodicity proof).
# Bounded BOTSv3 replay. Use DET-06 for process/network correlation.

index=botsv3 sourcetype=XmlWinEventLog EventCode=3
  earliest=1534723200 latest=1534809600
  \`botsv3_exclude_unix_ta_noise\`
| fields _time host User ProcessGuid Image DestinationIp DestinationPort
| where match(Image,"(?i)\\\\powershell(?:_ise)?\\.exe$")
    AND isnotnull(DestinationIp)
    AND NOT cidrmatch("10.0.0.0/8",DestinationIp)
    AND NOT cidrmatch("172.16.0.0/12",DestinationIp)
    AND NOT cidrmatch("192.168.0.0/16",DestinationIp)
| stats count min(_time) as first_time max(_time) as last_time
    by host User ProcessGuid Image DestinationIp DestinationPort
| where count > 100
| sort 0 -count
